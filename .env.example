# Copy to .env and fill in. See docs/SETUP.md for how to get these.
# They are compiled into the app at build time (the MAIN_VITE_ prefix exposes them to the main process).

# Google Cloud > Google Auth Platform > Clients > OAuth client (type: Desktop app)
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# Azure portal > Microsoft Entra ID > App registrations > Application (client) ID
MAIN_VITE_MICROSOFT_CLIENT_ID=
