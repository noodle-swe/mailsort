{
  "name": "mailsort",
  "productName": "MailSort",
  "version": "0.1.0",
  "description": "Unified Gmail + Outlook inbox with an MCP server and local Ollama email tagging",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "eval": "tsx scripts/eval-classifier.ts",
    "mcp:stdio": "node out/main/mcp-bridge.js",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "html-to-text": "^10.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
