{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/renderer/**/*", "src/preload/api.ts", "src/core/types.ts", "src/core/tags.ts", "src/core/dates.ts", "src/core/settings.ts", "src/core/events.ts", "src/core/ollama.ts"]
}
